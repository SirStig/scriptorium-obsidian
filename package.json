{
	"name": "scriptorium",
	"version": "0.1.0",
	"description": "Scriptorium — scripture references, app handoffs, previews, and vault study workflows for Obsidian.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"deploy": "npm run build && node scripts/install.mjs",
		"release": "npm run build && node scripts/package.mjs",
		"version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": ["obsidian", "obsidian-plugin", "bible"],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"builtin-modules": "^4.0.0",
		"esbuild": "^0.24.0",
		"obsidian": "^1.6.0",
		"typescript": "^5.5.0",
		"vitest": "^2.1.0"
	}
}
